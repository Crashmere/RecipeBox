[Unit]
Description=RecipeBox database and media backup

[Service]
Type=oneshot
User=recipebox
Group=recipebox
ExecStart=/opt/recipebox/bin/recipebox daily --data /opt/recipebox/data --out /opt/recipebox/backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# data 与 backups 必须在同一个挂载点，照片硬链接才能跨目录；其余内容归 root，应用用户仍不可写。
ReadWritePaths=/opt/recipebox
MemoryMax=256M
CPUQuota=50%
Nice=10
TimeoutStartSec=15min
