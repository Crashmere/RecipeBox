{
  "id": "recipebox",
  "name": "RecipeBox",
  "description": "家庭菜谱、常备食材与下厨日记。",
  "icon": "/portal/static/icons/recipebox.png",
  "url": "/recipebox/",
  "repo": "https://github.com/Crashmere/RecipeBox",
  "root": "/opt/recipebox",
  "port": 18083,
  "user": "recipebox",
  "units": [
    "recipebox.service",
    "recipebox-backup.service",
    "recipebox-backup.timer"
  ],
  "database": "/opt/recipebox/data/recipebox.db",
  "backupKind": "media",
  "resources": [
    {
      "id": "data",
      "name": "业务数据",
      "path": "/opt/recipebox/data",
      "purpose": "数据库、图片与历史迁移材料；临时文件不属于恢复数据。",
      "kind": "data",
      "browse": true,
      "cleanup": false
    },
    {
      "id": "backups",
      "name": "数据备份",
      "path": "/opt/recipebox/backups",
      "purpose": "daily、manual 与 before-deploy 一致性快照。",
      "kind": "backups",
      "browse": true,
      "cleanup": true
    },
    {
      "id": "releases",
      "name": "部署版本",
      "path": "/opt/recipebox/releases",
      "purpose": "程序、发布结果与 previous 回退材料。",
      "kind": "releases",
      "browse": true,
      "cleanup": true
    },
    {
      "id": "config",
      "name": "运行配置",
      "path": "/opt/recipebox/config",
      "purpose": "环境配置、systemd、Nginx 与资源声明；不直接展示秘密。",
      "kind": "config",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "bin",
      "name": "服务程序",
      "path": "/opt/recipebox/bin",
      "purpose": "当前应用程序及固定维护/发布脚本。",
      "kind": "binaries",
      "browse": false,
      "cleanup": false
    },
    {
      "id": "docs",
      "name": "维护文档",
      "path": "/opt/recipebox/docs",
      "purpose": "架构、API、运维与恢复说明。",
      "kind": "documents",
      "browse": true,
      "cleanup": false
    }
  ],
  "apis": [
    {
      "method": "GET",
      "path": "/healthz",
      "description": "数据库连接健康"
    },
    {
      "method": "GET",
      "path": "/api/records",
      "description": "全部未删除记录数组，不分页；查询参数 trash=1 取回收站，按 updatedAt、id 倒序"
    },
    {
      "method": "GET",
      "path": "/api/records/{id}",
      "description": "单个记录，包含 deletedAt，也可读取尚未清理的回收站记录"
    },
    {
      "method": "POST",
      "path": "/api/records",
      "description": "创建，kind=recipe/pantry、name 必填，action 省略或为 save；返回 200 和 Record"
    },
    {
      "method": "POST",
      "path": "/api/records/{id}",
      "description": "body 包含当前 revision；action 为 save/favorite/consume/log/remove_log/delete/restore，成功返回 200 和完整 Record"
    },
    {
      "method": "GET",
      "path": "/api/operations/{key}",
      "description": "取得原记录写入或上传结果，未知返回 404，不代表资源当前最新状态"
    },
    {
      "method": "POST",
      "path": "/api/uploads",
      "description": "原始图片文件 body（非 multipart），最大 25 MiB；返回 201 和 Media"
    },
    {
      "method": "GET",
      "path": "/api/media/{id}/main",
      "description": "标准 JPEG，仅有效暂存或未删除记录仍引用的照片"
    },
    {
      "method": "GET",
      "path": "/api/media/{id}/thumb",
      "description": "WebP 缩略图，使用与 main 相同的归属和有效期检查"
    },
    {
      "method": "GET",
      "path": "/api/export",
      "description": "全部未删除记录的 ZIP，含 recipes-and-pantry.json 与 photos/{id}.jpg，不含回收站"
    }
  ]
}
